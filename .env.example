# Copy this file to `.env` and fill values for local development
# TEMPORAL_ADDRESS is used by local services to reach Temporal (docker-compose)
TEMPORAL_ADDRESS=localhost:7233

# Groq (LLM) - put your API key here for local testing (use Secret Manager in Cloud Run)
GROQ_API_KEY=

# SMTP / Email notifier (used by `notifier_activity`)
# - Recommended: store SENDER_PASSWORD in Secret Manager for production
SENDER_EMAIL=alerts@example.com
SENDER_PASSWORD=changeme
RECIPIENT_EMAIL=oncall@example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587

# Optional tuning
GROQ_CALL_TIMEOUT=20
GROQ_CALL_RETRIES=1
